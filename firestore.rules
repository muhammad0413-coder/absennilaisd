rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        getUserData().role == 'admin'
      );
    }

    function isHeadmaster() {
      return isAuthenticated() && (
        request.auth.token.role == 'kepala_sekolah' ||
        getUserData().role == 'kepala_sekolah'
      );
    }

    function isTeacher() {
      return isAuthenticated() && (
        request.auth.token.role == 'guru' ||
        getUserData().role == 'guru'
      );
    }

    function getTeacherClass() {
      return getUserData().kelas_ditugaskan;
    }

    function isTeacherForClass(kelasId) {
      return isTeacher() && getTeacherClass() == kelasId;
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- STUDENTS COLLECTION (Data Induk Siswa Kelas 1–6) ---
    // Diisi melalui sinkronisasi Google Sheets -> Firestore. Website read-only.
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(); // Hanya Admin / Backend sync
    }

    // --- ATTENDANCE COLLECTION (Absensi Harian) ---
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || (
        isTeacherForClass(request.resource.data.Kelas)
      );
      allow delete: if isAdmin();
    }

    // --- GRADES COLLECTION (Nilai Siswa) ---
    match /grades/{gradeId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || (
        isTeacherForClass(request.resource.data.Kelas)
      );
      allow delete: if isAdmin();
    }

    // --- SETTINGS COLLECTION ---
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- SYNC JOBS & AUDIT LOGS ---
    match /syncJobs/{jobId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin() || isHeadmaster();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Append-only audit trail
    }
  }
}
