rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        request.auth.token.role == 'admin'
      );
    }

    function isTeacher() {
      return isAuthenticated() && (
        getUserData().role == 'guru' ||
        request.auth.token.role == 'guru'
      );
    }

    function isPrincipal() {
      return isAuthenticated() && (
        getUserData().role == 'kepsek' ||
        request.auth.token.role == 'kepsek'
      );
    }

    function isTeacherAssignedToClass(targetClass) {
      return isTeacher() && (
        targetClass in getUserData().assignedClasses
      );
    }

    // 1. Users collection
    match /users/{userId} {
      // User can read their own profile, admin can read/write all
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isPrincipal());
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId &&
        // Non-admin cannot escalate role or change assignedClasses
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'assignedClasses', 'active'])
      );
    }

    // 2. Students collection
    match /students/{studentId} {
      // Admin and Principal can read all. Teachers can read their assigned class.
      allow read: if isAdmin() || isPrincipal() || (
        isTeacher() && isTeacherAssignedToClass(resource.data.class)
      );
      // Admin can write any student. Teachers can only create/update students in their assigned class.
      allow create: if isAdmin() || (
        isTeacher() && isTeacherAssignedToClass(request.resource.data.class)
      );
      allow update: if isAdmin() || (
        isTeacher() && isTeacherAssignedToClass(resource.data.class) &&
        isTeacherAssignedToClass(request.resource.data.class)
      );
      // Soft deletion / deactivate only, physical delete restricted to Admin
      allow delete: if isAdmin();
    }

    // 3. Attendance collection
    match /attendance/{attendanceId} {
      allow read: if isAdmin() || isPrincipal() || (
        isTeacher() && isTeacherAssignedToClass(resource.data.class)
      );
      allow create: if isAdmin() || (
        isTeacher() && isTeacherAssignedToClass(request.resource.data.class)
      );
      allow update: if isAdmin() || (
        isTeacher() && isTeacherAssignedToClass(resource.data.class) &&
        isTeacherAssignedToClass(request.resource.data.class)
      );
      allow delete: if isAdmin();
    }

    // 4. Grades collection
    match /grades/{gradeId} {
      allow read: if isAdmin() || isPrincipal() || (
        isTeacher() && isTeacherAssignedToClass(resource.data.class)
      );
      allow create: if isAdmin() || (
        isTeacher() && isTeacherAssignedToClass(request.resource.data.class)
      );
      allow update: if isAdmin() || (
        isTeacher() && isTeacherAssignedToClass(resource.data.class) &&
        isTeacherAssignedToClass(request.resource.data.class)
      );
      allow delete: if isAdmin();
    }

    // 5. School Profile & Settings (Public read for active academic year / school identity)
    match /schoolProfile/{profileId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 6. Sync Jobs & Audit Logs (Admin only write, audit append)
    match /syncJobs/{jobId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin() || isPrincipal();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }

    // 7. Student Portal Access Collection
    match /studentPortalAccess/{accessId} {
      // Portal read requires specific matching document ID query
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
