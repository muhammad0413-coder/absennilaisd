# ===================================================
# SISTEM INFORMASI ABSENSI DAN NILAI SISWA SD
# Environment Variables Template (Vite & Frontend)
# ===================================================

# 1. Konfigurasi Firebase Web Client SDK
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-school-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-school-app-id
VITE_FIREBASE_STORAGE_BUCKET=your-school-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# 2. URL Deployment Google Apps Script Web App
# Diperoleh setelah Deploy -> New Deployment -> Web App (Execute as: Me, Who has access: Anyone)
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxExampleDeploymentID/exec

# 3. Secret Kunci API Integrasi (Opsional / Sinkronisasi Backend)
VITE_API_SECRET_KEY=sd_secret_sync_key_change_in_production
