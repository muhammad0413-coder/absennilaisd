# ==============================================================================
# KONFIGURASI CLIENT-SIDE (Vercel & Browser)
# CATATAN KEAMANAN:
# Variabel dengan prefix VITE_ dapat dibaca oleh client di browser.
# JANGAN PERNAH menyimpan Private Key, Secret Token, atau Service Account di sini!
# ==============================================================================

# URL Web App Google Apps Script (Deployment: Anyone with Google Account or Anyone)
# Backend ini yang memvalidasi Firebase Token, Hak Akses, Google Sheets, & Google Drive.
VITE_GAS_API_URL="https://script.google.com/macros/s/AKfycbxXXXXXXXXXXXXXXXXXXXXXXXXXXXXX/exec"

# Firebase Public Configuration (Didapatkan dari Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
VITE_FIREBASE_AUTH_DOMAIN="sd-absensi-penilaian.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="sd-absensi-penilaian"
VITE_FIREBASE_STORAGE_BUCKET="sd-absensi-penilaian.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# Identitas Sekolah Default
VITE_SCHOOL_NAME="SD NEGERI HARAPAN BANGSA"
VITE_SCHOOL_NPSN="20109988"
VITE_ACADEMIC_YEAR="2026/2027"
VITE_SEMESTER="1 (Ganjil)"

# Mode Demo (true jika belum menghubungkan Firebase/Google Apps Script asli)
VITE_ENABLE_DEMO_FALLBACK="true"
